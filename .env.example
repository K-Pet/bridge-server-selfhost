# Bridge Music Server — environment template.
# Copy to .env, fill the four lines below, then `docker compose up -d`.
#
# Full deployment runbook: README.md

# ─── Where your music will live on disk ─────────────────────────────
# Defaults to ./data/music inside the repo. Point at a real path on
# your NAS / external drive if you have one.
MUSIC_DIR=./data/music

# ─── Friendly name for this server ──────────────────────────────────
# Shows up in the marketplace UI. Pick anything — "Living Room",
# "Kitchen Server", "Mom's Server", etc.
BRIDGE_LABEL=My Bridge Server

# ─── Who the server runs as ─────────────────────────────────────────
# The container runs its two processes unprivileged and drops to this
# uid/gid. 1000 is right for a fresh Linux host.
#
# Set these to match MUSIC_DIR's existing owner if you're bringing a
# library you already have. On boot the container takes ownership of
# anything under /data that isn't already its own — which is how upgrades
# work without you running chown, but it means it will rewrite your music
# files' ownership to 1000 unless you tell it who you are. On a share it
# can't chown (read-only, NFS root squash) it warns instead, and writes
# fail while reads keep working. Find the values with:
#
#   stat -c '%u:%g' /path/to/your/music
#
# PUID=1000
# PGID=1000

# ─── Resource ceilings ──────────────────────────────────────────────
# Sensible on a dedicated box; lower them if you're running several
# instances on one host (see README.md).
# BRIDGE_CPUS=2.0
# BRIDGE_MEMORY=2g
# BRIDGE_PIDS=512

# ─── Public URL the marketplace will deliver purchases to ──────────
# Use a real HTTPS domain or a Cloudflare Tunnel URL — see
# README.md for the two options. Purchases are pushed here the
# moment they clear. If the URL can't be reached from the internet the
# server still gets them: it checks with the marketplace every 15
# minutes for anything the push missed.
BRIDGE_EXTERNAL_URL=https://music.example.com

# That's it for required config — three lines above.
#
# As of Phase 2b, bridge-server no longer needs the Supabase project's
# service-role key OR JWT secret. Privileged operations (auto-pair,
# delivery status updates, storage URL signing, the reconciler's
# pending-purchase fetch) all run through Supabase Edge Functions
# authenticated by either the auto-minted webhook_secret
# (server-context calls) or the user's forwarded JWT (onboarding
# calls). JWT verification round-trips through
# ${SUPABASE_URL}/auth/v1/user with the publishable anon key.

# Server identity (BRIDGE_SERVER_ID) and webhook HMAC secret
# (BRIDGE_WEBHOOK_SECRET) are auto-minted on first boot and persisted
# to /data/bridge/credentials.json. Don't set them here.
#
# There is nothing to configure for linking. A server is linked by
# signing in at its web UI and pressing one button; there is no setup
# code. Until somebody does, every gated route fails closed and the UI
# shows the link screen and nothing else — so claim it before you share
# the URL, because whoever presses the button first owns it.

# ─── Optional: deterministic Navidrome admin password ───────────────
# When set, the embedded Navidrome's admin password is derived as
# sha256(BRIDGE_SECRET + ":navidrome-admin") instead of being random.
# Useful if you need to recover the password from the secret alone.
# Treat it as a credential — anyone holding it holds Navidrome admin.
# BRIDGE_SECRET=

# ─── Optional: hCaptcha site key ────────────────────────────────────
# Required only if your Supabase project has captcha enforcement
# enabled (Authentication → Settings → Bot and Abuse Protection).
# This is the *public* site key — paired with a secret key held by
# Supabase. Ship the same key your iOS / Marketplace clients use so
# every entry point hits the same hCaptcha config.
# BRIDGE_HCAPTCHA_SITE_KEY=

# ─── Optional: library size limit ───────────────────────────────────
# Caps how large the music library may grow, in bytes. Imports and
# purchase deliveries that would cross it are refused with a message
# that names the number, instead of failing when the disk fills. Unset
# (or 0) means the disk is the limit, which is right for a self-hosted
# server. Managed hosting sets this to the plan size.
# BRIDGE_STORAGE_LIMIT_BYTES=64424509440   # 60 GiB

# ─── Optional: MusicBrainz enrichment ───────────────────────────────
# After an import commits, files missing tags are matched against
# MusicBrainz by text search, using their tags and their file and folder
# names ("03 - Title.flac" in "Artist - Album (2001)/"). A folder whose
# best release is clearly right gets MusicBrainz ids, any missing tags
# and a front cover written; the rest wait in Settings → Identification,
# where MusicBrainz can also be searched by hand or a link pasted. No
# API key is needed: MusicBrainz reads only ask for one request per
# second per IP and a User-Agent, both built in.
#
# BRIDGE_ENRICH_ENABLED=true          # the feature as a whole
# BRIDGE_ENRICH_AUTO_ON_IMPORT=true   # queue a job after every import commit
# BRIDGE_ENRICH_AUTO_SCOPE=untagged   # untagged: skip files with a title plus artist or album; all: every file without ids
# BRIDGE_ENRICH_MIN_SCORE=85          # release match score (0–100) needed to apply without review; values <= 1 read as 0–1
# BRIDGE_ENRICH_FETCH_COVERS=true     # download front covers from the Cover Art Archive
# BRIDGE_ENRICH_MB_INTERVAL=1100ms    # spacing between MusicBrainz calls; their rule is >= 1s per IP

# ─── Optional: session verification ─────────────────────────────────
# Every request carries the signed-in account's Supabase token. A
# verified token is trusted for BRIDGE_AUTH_CACHE_TTL before it is
# checked again. With BRIDGE_AUTH_LOCAL_JWT=true (the default) tokens
# from a project that has migrated to asymmetric JWT signing keys are
# checked in-process against the project's published keys — no round
# trip at all; tokens from a project still on the legacy shared secret
# fall back to ${SUPABASE_URL}/auth/v1/user automatically. Local checks
# cannot see a sign-out until the token expires (an hour), where the
# network check sees it within the cache TTL.
#
# BRIDGE_AUTH_CACHE_TTL=5m
# BRIDGE_AUTH_LOCAL_JWT=true
